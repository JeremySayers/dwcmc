---
/**
 * Marks a claim that hasn't been confirmed for 1.1 yet, so readers know to test it.
 * Use it instead of stating an unverified mechanic as fact. Remove it once the claim
 * is tested in 1.1 or confirmed in 1.1 code, and add the source to the page's Sources.
 *
 *   <Unconfirmed basis="Seen in 1.2 code, not checked in 1.1">
 *     Mobs only wander at random for about their first 5 seconds.
 *   </Unconfirmed>
 */
interface Props {
  /** Where the claim comes from, e.g. "Seen in 1.2 code". */
  basis?: string;
  title?: string;
}

const { basis, title = 'Not yet confirmed in 1.1' } = Astro.props;
---

<aside class="unconfirmed" role="note">
  <div class="head">
    <span class="mark slot" aria-hidden="true">
      ?
    </span>
    <b>{title}</b>
    {basis && <em>{basis}</em>}
  </div>
  <div class="body">
    <slot />
  </div>
</aside>

<style>
  .unconfirmed {
    margin: 18px 0;
    padding: 12px 16px 14px;
    max-width: var(--measure);
    background: var(--unconfirmed-bg);
    border: 2px dashed var(--unconfirmed-border);
    color: var(--ink);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 10px;
  }

  .mark {
    width: 26px;
    height: 26px;
    display: grid;
    place-items: center;
    font: var(--px-md) / 1 var(--font-pixel);
    color: #fff;
    text-shadow: 1px 1px 0 var(--title);
  }

  b {
    font: var(--px-lg) / 1.2 var(--font-pixel);
    color: var(--unconfirmed-text);
  }

  em {
    font: normal var(--px-sm) / 1.3 var(--font-pixel);
    color: var(--ink-2);
  }

  .body {
    margin-top: 8px;
    font-size: var(--text-small);
    line-height: 1.55;
  }

  .body :global(p) {
    margin: 0 0 8px;
  }

  .body :global(p:last-child),
  .body :global(ul:last-child) {
    margin-bottom: 0;
  }

  .body :global(ul) {
    margin: 0 0 8px;
    padding-left: 20px;
  }
</style>
