---
/**
 * Top-down maps of a build, one per block of height, bottom first, with a legend and
 * a count of the blocks you need. Layers are lists of strings, one character per block;
 * the characters are defined in src/lib/blocks.ts.
 *
 *   import { ETHOS_LAYERS } from '@/lib/designs/ethos-mob-system';
 *   <LayerDiagram layers={ETHOS_LAYERS} label="One layer of Etho's mob system" />
 */
import { CELLS, countCells, materials, type CellType, type DiagramLayer } from '@/lib/blocks';

interface Props {
  layers: DiagramLayer[];
  /** What the diagram shows, for screen readers and the caption. */
  label: string;
  /** Extra line under the shopping list, e.g. "Stack 5 to 10 of these." */
  footnote?: string;
}

const { layers, label, footnote } = Astro.props;
const cells = CELLS as Record<string, CellType>;
const width = layers[0]?.rows[0]?.length ?? 0;
const depth = layers[0]?.rows.length ?? 0;
const used = countCells(layers);
const legend = Object.entries(cells).filter(([ch, c]) => c.legend && used.has(ch));
const shopping = materials(layers);

// The maps are drawn on canvases in device pixels (see src/lib/draw-layer.ts), so the
// grid lines stay even with display scaling. This is only the largest size a map is shown at.
const mapWidth = width * 14 + (width - 1) + 2 * 4;
---

<figure class="diagram" aria-label={label} style={`--map-w: ${mapWidth}px`}>
  <figcaption class="summary">
    <b>{label}</b>
    <span>
      {width} × {depth} · {layers.length} blocks high · bottom layer first
    </span>
  </figcaption>

  <ol class="layers">
    {layers.map((layer, i) => (
      <li class="layer">
        <h4>
          <span class="num slot">{i + 1}</span>
          {layer.name}
        </h4>
        <div class="map">
          <canvas
            data-layer-canvas
            data-rows={JSON.stringify(layer.rows)}
            width={mapWidth}
            height={Math.round((mapWidth * depth) / width)}
            style={`aspect-ratio: ${width} / ${depth}`}
            role="img"
            aria-label={`Block ${i + 1} from the bottom: ${layer.name}. ${layer.note ?? ''}`}
          />
        </div>
        {layer.note && <p class="note">{layer.note}</p>}
      </li>
    ))}
  </ol>

  <div class="foot">
    <ul class="legend" aria-label="Legend">
      {legend.map(([ch, c]) => (
        <li>
          <canvas data-layer-canvas data-cell={ch} width="18" height="18" aria-hidden="true" />
          {c.label}
        </li>
      ))}
    </ul>
    <div class="shopping">
      <h4>You need</h4>
      <table>
        <tbody>
          {shopping.map((m) => (
            <tr>
              <td>{m.material}</td>
              <td class="n">{m.count.toLocaleString('en-US')}</td>
            </tr>
          ))}
        </tbody>
      </table>
      {footnote && <p class="note">{footnote}</p>}
    </div>
  </div>
</figure>

<script>
  import { drawLayer, drawSwatch } from '@/lib/draw-layer';

  // Redraw whenever a canvas's size in device pixels changes: on load, on resize,
  // and when the window moves to a screen with different scaling.
  const ro = new ResizeObserver((entries) => {
    const dpr = window.devicePixelRatio || 1;
    for (const e of entries) {
      const canvas = e.target as HTMLCanvasElement;
      const box = e.devicePixelContentBoxSize?.[0];
      const w = box ? box.inlineSize : Math.round(e.contentRect.width * dpr);
      const h = box ? box.blockSize : Math.round(e.contentRect.height * dpr);
      if (canvas.dataset.rows) drawLayer(canvas, JSON.parse(canvas.dataset.rows), w, h, dpr);
      else drawSwatch(canvas, canvas.dataset.cell ?? '', w, h);
    }
  });
  for (const canvas of document.querySelectorAll<HTMLCanvasElement>('canvas[data-layer-canvas]')) {
    try {
      ro.observe(canvas, { box: 'device-pixel-content-box' });
    } catch {
      ro.observe(canvas);
    }
  }
</script>

<style>
  .diagram {
    margin: 20px 0;
    max-width: none;
    display: grid;
    gap: 16px;
  }

  .summary {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 14px;
  }

  .summary b {
    font: var(--px-lg) / 1.2 var(--font-pixel);
    color: var(--title);
  }

  .summary span {
    font: var(--px-sm) / 1.2 var(--font-pixel);
    color: var(--ink-2);
  }

  .layers {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, var(--map-w)), 1fr));
    gap: 18px;
  }

  .layer {
    display: grid;
    gap: 8px;
    align-content: start;
    max-width: var(--map-w);
  }

  h4 {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    font: var(--px-md) / 1 var(--font-pixel);
    color: var(--title);
  }

  .num {
    width: 24px;
    height: 24px;
    display: grid;
    place-items: center;
    font: var(--px-sm) / 1 var(--font-pixel);
    color: #fff;
    text-shadow: 1px 1px 0 var(--title);
  }

  .map {
    border: 2px solid var(--edge);
    background: var(--slot-dark);
    line-height: 0;
  }

  .map canvas {
    display: block;
    width: 100%;
    height: auto;
  }

  .note {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--ink-2);
  }

  .foot {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 260px);
    gap: 16px 28px;
    align-items: start;
  }

  .legend {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
    gap: 6px 14px;
    font-size: 14px;
  }

  .legend li {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .legend canvas {
    width: 18px;
    height: 18px;
    flex: none;
    outline: 1px solid var(--slot-dark);
  }

  .shopping h4 {
    margin-bottom: 6px;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
    font-variant-numeric: tabular-nums;
  }

  .shopping td {
    padding: 4px 0;
    border-bottom: 1px dotted #a8a8a8;
  }

  .shopping .n {
    text-align: right;
    font-weight: 600;
  }

  .shopping .note {
    margin-top: 8px;
  }

  @media (max-width: 700px) {
    .foot {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
