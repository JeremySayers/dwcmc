---
/**
 * A light paper panel holding prose. Pages with `layout: panels` stack these;
 * article pages get one automatically.
 */
interface Props {
  id?: string;
  label?: string;
}

const { id, label } = Astro.props;
---

<section class="paper" id={id} aria-label={label}>
  <div class="prose">
    <slot />
  </div>
</section>

<style>
  section {
    scroll-margin-top: 20px;
  }
</style>
