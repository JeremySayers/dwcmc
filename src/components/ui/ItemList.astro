---
/**
 * A list of <Item>s: an icon in an inventory slot, a title, and a line of text.
 * Two columns on wide screens by default; one column on phones.
 */
interface Props {
  columns?: 1 | 2;
}

const { columns = 2 } = Astro.props;
---

<ul class:list={['items', `cols-${columns}`]}>
  <slot />
</ul>

<style>
  .items {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    display: grid;
    gap: 12px 18px;
  }

  .cols-1 {
    grid-template-columns: minmax(0, 1fr);
    max-width: var(--measure);
  }

  .cols-2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    max-width: none;
  }

  @media (max-width: 900px) {
    .cols-2 {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
