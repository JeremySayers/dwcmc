---
import Button from '@/components/ui/Button.astro';
import PixelIcon from '@/components/ui/PixelIcon.astro';
import type { NavGroup } from '@/lib/nav';
import type { SectionId } from '@/lib/sections';
import { withBase } from '@/lib/url';

interface Props {
  nav: NavGroup[];
  currentSection: SectionId | null;
  isHome: boolean;
}

const { nav, currentSection, isHome } = Astro.props;
const sections = nav.filter((g) => g.section.inTopNav);
---

<header class="top bev">
  <a class="logo" href={withBase('/')} aria-label="DWCMC home">
    <PixelIcon name="grass" size={40} />
    <span class="name">DWCMC</span>
    <span class="tagline">A field guide to Minecraft 1.1</span>
  </a>
  <nav class="topnav" aria-label="Sections">
    <Button href="/" current={isHome}>
      Home
    </Button>
    {sections.map((g) => (
      <Button href={g.firstHref} current={!isHome && currentSection === g.section.id}>
        {g.section.name}
      </Button>
    ))}
  </nav>
</header>

<style>
  .top {
    max-width: var(--max-w);
    margin: 0 auto 20px;
    display: flex;
    align-items: center;
    gap: 14px 24px;
    padding: 12px 16px;
    flex-wrap: wrap;
  }

  .logo {
    display: grid;
    grid-template-columns: auto auto;
    grid-template-rows: auto auto;
    column-gap: 12px;
    align-items: center;
    text-decoration: none;
  }

  .logo :global(svg) {
    grid-row: span 2;
    filter: drop-shadow(2px 2px 0 #0006);
  }

  /*
   * Dark grey with no shadow, like the titles on the game's inventory screens.
   * (A drop shadow makes Tiny5's C look like a G.) 40px keeps Tiny5's pixels on a 5px grid.
   */
  .name {
    font: 40px/1 var(--font-logo);
    color: var(--title);
  }

  .tagline {
    font: var(--px-sm) / 1.2 var(--font-pixel);
    color: var(--ink-2);
  }

  .topnav {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-left: auto;
  }

  @media (max-width: 560px) {
    .topnav {
      margin-left: 0;
    }
  }
</style>
