---
/**
 * Renders every published page of the guide collection.
 * src/content/guide/index.mdx becomes "/", mechanics/pistons.mdx becomes "/mechanics/pistons/".
 */
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import AppliesTo from '@/components/ui/AppliesTo.astro';
import { SECTIONS } from '@/lib/sections';

export async function getStaticPaths() {
  const entries = await getCollection('guide', (e) => e.data.status === 'published');
  return entries.map((entry) => ({
    params: { slug: entry.id === 'index' ? undefined : entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const { title, description, section, template, eyebrow, nav, versions } = entry.data;
const sectionName = SECTIONS.find((s) => s.id === section)?.name;
const isHome = entry.id === 'index';
---

<BaseLayout
  title={isHome ? null : title}
  description={description}
  currentId={entry.id}
  currentSection={section}
  headings={headings}
  noindex={!nav}
>
  {template === 'panels' ? (
    <Content />
  ) : (
    <article class="paper">
      <div class="prose">
        <Eyebrow>{eyebrow ?? sectionName}</Eyebrow>
        <h1>{title}</h1>
        {versions && <AppliesTo versions={versions} />}
        <Content />
      </div>
    </article>
  )}
</BaseLayout>
